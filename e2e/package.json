{
  "name": "bloodtrack-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "E2E tests (Playwright) for chemotherapy blood tracker - runs against the full Docker stack",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "install-browser": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
