# --- Server ---
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/bloodtrack

# --- SMS (local) ---
SMS_PROVIDER=fixed
SMS_FIXED_CODE=123456

# --- Lab report vision (multi-provider) ---
# Secrets: only in this file / cloud env vars — NEVER commit real values.
# Primary: mock | xai | openai | openai_compatible | tencent
LAB_REPORT_PROVIDER=mock
# Fallback chain (comma-separated). Production does NOT auto-append mock.
LAB_REPORT_FALLBACK=mock
# Client may pick provider in miniapp chips:
#   development: default ON (set false to disable)
#   production:  default OFF (must set true explicitly — not recommended)
# LAB_REPORT_ALLOW_CLIENT_OVERRIDE=false
#
# Switch helper (writes .env, restart backend after):
#   npm run lab-provider:show
#   ./scripts/switch-lab-provider.sh mock
#   ./scripts/switch-lab-provider.sh xai mock
#   ./scripts/switch-lab-provider.sh tencent mock

# xAI Grok vision
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_VISION_MODEL=grok-4.5

# OpenAI or any OpenAI-compatible vision gateway
# OPENAI_API_KEY=
# or LAB_REPORT_API_KEY=
# LAB_REPORT_BASE_URL=https://api.openai.com/v1
# LAB_REPORT_MODEL=gpt-4o

# Tencent Cloud OCR (GeneralAccurateOCR + local metric rules)
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_OCR_REGION=ap-guangzhou
